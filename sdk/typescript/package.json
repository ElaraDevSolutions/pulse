{
  "name": "pulse-sdk",
  "version": "0.0.4",
  "description": "Pulse SDK for Node.js/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/copy-proto.js",
    "test": "jest"
  },
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "prepare": "npm run build",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
    ,"@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.5"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.8.0",
    "protobufjs": "^7.2.0",
    "@grpc/proto-loader": "^0.7.0"
    ,"js-yaml": "^4.1.0"
  }
,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"]
  }
}
